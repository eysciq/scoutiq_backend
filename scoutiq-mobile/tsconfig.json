{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    // 🔥 Expo tarafındaki TypeScript 5.0 uyarısını buraya ekliyoruz
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "**/*.js", 
    "**/*.jsx",
    "expo-env.d.ts"
  ]
}