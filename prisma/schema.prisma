generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String       @id @default(uuid())
  email                 String       @unique
  password              String
  name                  String
  totalScoutScore       Float        @default(0)
  weeklyScore           Float        @default(0)
  successfulPredictions Int          @default(0)
  createdAt             DateTime     @default(now())
  
  predictions           Prediction[]
  
  @@index([totalScoutScore(sort: Desc), successfulPredictions(sort: Desc)])
}

model Player {
  id           String       @id @default(uuid())
  externalId   Int          @unique
  name         String
  position     String
  team         String
  predictions  Prediction[]
}

model Prediction {
  id              String   @id @default(uuid())
  userId          String
  playerId        String
  predictedAt     DateTime @default(now())
  isVisible       Boolean  @default(false)
  hasScoutBadge   Boolean  @default(false)
  pointsEarned    Float    @default(0)
  isProcessed     Boolean  @default(false)

  user            User     @relation(fields: [userId], references: [id])
  player          Player   @relation(fields: [playerId], references: [id])

  @@unique([userId, playerId])
}